# Dedicated keeper wallet. Holds only gas money; distributeYield() is permissionless.
KEEPER_PRIVATE_KEY=

# Comma-separated, tried in order.
RPC_URLS=https://rpc.gnosischain.com,https://gnosis-rpc.publicnode.com

# Optional: success and failure messages.
DISCORD_WEBHOOK_URL=

# Optional: healthchecks.io ping URL; it alerts when pings stop.
HEALTHCHECK_URL=

MIN_BALANCE_XDAI=0.2

# Set to 1 to do everything except send the transaction.
DRY_RUN=

# Saving Circles executor wallet. Must be set as automationExecutor on each
# AutomaticSavingCircles contract; holds only gas money (xDAI on Gnosis, CELO on Celo).
SAVING_CIRCLES_EXECUTOR_PRIVATE_KEY=

# Optional: comma-separated, tried in order. Empty uses public RPCs.
SAVING_CIRCLES_GNOSIS_RPC_URLS=
SAVING_CIRCLES_CELO_RPC_URLS=

# Optional: separate healthchecks.io check for the daily Saving Circles runs. Falls back to HEALTHCHECK_URL.
SAVING_CIRCLES_HEALTHCHECK_URL=
