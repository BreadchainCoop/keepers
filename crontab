# supercronic never overlaps runs of the same job.
*/30 * * * * /app/jobs/distribute-yield.sh
# Matches the previous Cloudflare executor's daily run; the checkers make polling more often safe.
0 0 * * * /app/jobs/saving-circles.sh gnosis
0 0 * * * /app/jobs/saving-circles.sh celo
